{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.simonavatcheva.com" }],
      "destination": "https://simonavatcheva.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/study-easy", "destination": "/study-easy/index.html" },
    { "source": "/study-easy/(.*)", "destination": "/study-easy/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
